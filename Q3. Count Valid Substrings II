
class Solution {
    public long countValidSubstrings(String s) {
        int n = s.length();

        int lastA = -1;
        int lastAB = -1;
        int lastABC = -1;

        long total = 0;

        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);

            if (ch == 'c' && lastAB != -1) {
                lastABC = lastAB;
            }

            if (ch == 'b' && lastA != -1) {
                lastAB = lastA;
            }

            if (ch == 'a') {
                lastA = i;
            }

            total += i - lastABC;
        }

        return total;
    }
}
