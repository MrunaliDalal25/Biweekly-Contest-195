
import java.util.*;

class Solution {
    public boolean canRemoveAll(int[] types, int[] colors, int[] groupSize) {

        Stack<int[]> stack = new Stack<>();

        for (int i = 0; i < types.length; i++) {

            int type = types[i];
            int color = colors[i];

            if (!stack.isEmpty() &&
                stack.peek()[0] == type &&
                stack.peek()[1] == color) {

                stack.peek()[2]++;
            } else {
                stack.push(new int[]{type, color, 1});
            }

            if (!stack.isEmpty() &&
                stack.peek()[2] == groupSize[stack.peek()[0]]) {

                stack.pop();
            }
        }

        return stack.isEmpty();
    }
}
